# ==============================================================================
# Git Ignore Configuration for Django Student Management System (BBU)
# ==============================================================================

# 1. Virtual Environments (CRITICAL: Never commit python environments)
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
bin/
lib/
include/

# 2. Python Bytecode, Cache & Compiled Files
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
parts/
var/
sdist/
develop-eggs/
.Python

# 3. Environment Variables & Secrets (CRITICAL: Never commit credentials or secrets)
.env
.env.local
.env.*.local
*.env
*.pem
*.key
credentials.json
client_secret*.json

# 4. SQLite Database (Local dev db - Production uses PostgreSQL on Render/Heroku)
*.sqlite3
*.sqlite3-journal
db.sqlite3
db.sqlite3-journal

# 5. Django Collected Static Files (Generated during production deploy build)
staticfiles/

# 6. User Uploaded Media Files (Keep folder structure via .gitkeep, ignore uploads)
media/*
!media/.gitkeep
media/profiles/*
!media/profiles/.gitkeep
media/uploads/*
!media/uploads/.gitkeep

# 7. Server Logs & Runtime Outputs
*.log
server.log
server_logs/
*.pid
*.tmp
*.bak

# 8. Testing, Linting & Coverage
.coverage
.coverage.*
.pytest_cache/
nosetests.xml
coverage.xml
htmlcov/
.tox/
.nox/

# 9. IDEs & Text Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# 10. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# 11. Antigravity & Agent Temporary Files
scratch/
.gemini/
.system_generated/
