# ==============================================================================
# Git Ignore Configuration for Django Student Management System (BBU)
# ==============================================================================

# 1. Virtual Environments (CRITICAL: Never commit python environments)
venv/
.venv/
.venv*/
env/
ENV/
env.bak/
venv.bak/
/bin/
/lib/
/include/
__pypackages__/

# 2. Python Bytecode, Cache & Build Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
parts/
var/
sdist/
develop-eggs/
.mypy_cache/
.dmypy.json
.ruff_cache/
.pytest_cache/
.hypothesis/
.cache/
.Python

# 3. Environment Variables & Secrets (CRITICAL: Never commit credentials)
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.development
*.env
*.pem
*.key
credentials.json
client_secret*.json
local_settings.py

# 4. Local SQLite Databases (Production uses a real DB server)
*.sqlite3
*.sqlite3-journal
db.sqlite3
db.sqlite3-journal

# 5. Django Collected Static Files (Generated by collectstatic)
/staticfiles/

# 6. User Uploaded Media Files (keep folder structure via .gitkeep)
media/*
!media/.gitkeep
media/profiles/*
!media/profiles/.gitkeep
media/uploads/*
!media/uploads/.gitkeep

# 7. Compiled Translation Files (generated by compilemessages)
*.mo

# 8. Server Logs & Runtime Outputs
*.log
server.log
server_logs/
*.pid
*.tmp
*.bak
*.orig
*.rej

# 9. Testing, Linting & Coverage
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.tox/
.nox/

# 10. IDEs & Text Editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# 11. Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# 12. Agent / Temporary Scratch Files
scratch/
.gemini/
.system_generated/
